{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/db-provider.mjs prestart",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/test-runner.ts",
    "test:dev-db": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "smoke": "tsx scripts/smoke.ts",
    "secrets": "tsx scripts/check-secrets.ts",
    "precommit": "lint-staged --config lint-staged.config.mjs",
    "hygiene": "tsx scripts/check-hygiene.ts",
    "lint:budget": "tsx scripts/check-lint-budget.ts",
    "audit:prod": "tsx scripts/check-audit.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/db-provider.mjs generate",
    "roles:sync": "tsx prisma/sync-roles.ts",
    "ingest:key": "tsx scripts/create-ingest-key.ts",
    "prisma:pg:schema": "tsx scripts/gen-pg-schema.ts",
    "prisma:pg:check": "tsx scripts/pg-migration.ts --check",
    "prisma:pg:migration": "tsx scripts/pg-migration.ts",
    "build:railway": "npm run prisma:pg:schema && prisma generate --schema prisma/postgres/schema.prisma && next build",
    "start:railway": "sh scripts/start-railway.sh",
    "seed:prod": "tsx scripts/seed-prod.ts",
    "sections:sync": "tsx scripts/sync-sections.ts",
    "areas:sync": "tsx scripts/sync-areas.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "user:create-admin": "tsx scripts/create-admin.ts",
    "user:grant-access": "tsx scripts/grant-access.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
