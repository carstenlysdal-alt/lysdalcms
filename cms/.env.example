# ── Lysdals CMS — environment ──────────────────────────────────────────────
# Copy to .env and adjust. Dev bruger SQLite (ingen opsætning). Produktion (Railway) bruger PostgreSQL via det afledte
# skema prisma/postgres/schema.prisma (npm run build:railway / start:railway) — prisma/schema.prisma forbliver SQLite.
# Produktions-variabler sættes i Railway, ikke i en fil: se docs/ops/RAILWAY-SETUP.md.
# .env må ALDRIG committes. Roter alle værdier hvis de nogensinde har været i git.

# SQLite (dev default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (produktion/Railway). På Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (variabel-reference, ikke en kopieret værdi).
# DATABASE_URL="postgresql://user:password@host:5432/railway"
# Valgfri: antal forbindelser i Prisma-puljen pr. proces (default 10 ved postgres)
# DATABASE_POOL_SIZE="10"

# Auth.js — PÅKRÆVET i produktion (serveren nægter at starte uden). Generate with: openssl rand -base64 48  (min. 32 tegn; unik pr. miljø)
AUTH_SECRET=""
# Bag proxy/hosting (Railway, Vercel, nginx): Auth.js skal stole på host-headeren. PÅKRÆVET på Railway.
# AUTH_TRUST_HOST=true

# Public app URL (used by Auth.js callbacks, canonical URLs). PÅKRÆVET i produktion (http/https-URL), fx https://slagelselokalt.dk
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Standardinstans når host ikke matcher en by (fx localhost)
DEFAULT_SITE_DOMAIN="slagelselokalt.dk"
# Kun test/staging, før de rigtige domæner er koblet på: lader ukendte værter (fx *.up.railway.app) vise denne by. FJERN når domænerne er live.
# FALLBACK_SITE_DOMAIN="slagelselokalt.dk"
# Preview-værter (lib/preview.ts): kommaseparerede hostnavne (uden https://, sti, port eller wildcard), hvor ALLE seks byer kan ses via
# ?by=slagelse|naestved|holbaek|koege|roskilde|ringsted (cookien lk_by, 30 dage). Kun til den delte Railway-adresse, mens ejeren ikke har egne
# domæner: sitet er noindex dér og aldrig delt-cache'bart. By-domæner (fx naestvedlokalt.dk) ignoreres og giver en advarsel. Fjern når domænerne er live.
# PREVIEW_HOSTS="lysdalcms-production.up.railway.app"

# ── AI-assistent (/redaktion/chat → /api/chat) ─────────────────────────────
# Uden nøgle svarer /api/chat med 503. Hold nøglen server-side (aldrig NEXT_PUBLIC_).
ANTHROPIC_API_KEY=""
# Valgfri model-override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── AI-operatør: valg af modeludbyder (/api/operator) ──────────────────────
# Gælder KUN AI-operatøren. Editorens AI, forside-AI og chatten vælges separat (se "Fælles AI-gateway" nedenfor).
# Uden OPERATOR_PROVIDER: DeepSeek hvis DEEPSEEK_API_KEY er sat, ellers Anthropic hvis ANTHROPIC_API_KEY er sat, ellers 503.
# DeepSeek behandler data uden for EU: operatøren maskerer persondata, før noget sendes (docs/localrating/adr/ADR-017.md).
# Sæt nøglen som Railway-variabel fra din egen terminal (aldrig i chat/git), se docs/ops/RAILWAY-SETUP.md.
DEEPSEEK_API_KEY=""
# Valgfrit (defaults: deepseek-chat og https://api.deepseek.com)
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Valgfrit eksplicit valg: deepseek | anthropic (et eksplicit valg falder aldrig stille tilbage til den anden udbyder)
# OPERATOR_PROVIDER="deepseek"

# ── Fælles AI-gateway: editor-AI, AI-chat (AI-dock) og forside-AI ──────────
# Udbyder: <OPGAVE>_AI_PROVIDER, ellers AI_PROVIDER, ellers DeepSeek hvis DEEPSEEK_API_KEY er sat, ellers Anthropic hvis ANTHROPIC_API_KEY er sat.
# Værdier: deepseek | anthropic. Et eksplicit valg falder aldrig stille tilbage til den anden udbyder (mangler nøglen, er AI slået fra).
# AI_PROVIDER="deepseek"
# EDITOR_AI_PROVIDER="deepseek"
# CHAT_AI_PROVIDER="deepseek"
# FRONTPAGE_AI_PROVIDER="deepseek"

# ── Agent-indtag (/api/ingest/*) ───────────────────────────────────────────
# Nøgler gemmes IKKE i miljøvariabler: de oprettes pr. instans og gemmes som sha256-hash i tabellen ApiKey.
#   npm run ingest:key -- --domain naestvedlokalt.dk --name "aI-library / Graver"
# Agent-siden (aI-library / Knowledge OS) gemmer klartekst-nøglen i sit eget secret store, fx:
# CMS_INGEST_BASE_URL="https://naestvedlokalt.dk"
# CMS_INGEST_API_KEY="lk_…"

# ── Modulær forside / AI-forslag (T11/T12) ────────────────────────────────
# Cron-ruten GET|POST /api/cron/frontpage-rank opretter FORSLAG til forsiden (publicerer aldrig; en redaktør godkender).
# Påkrævet for at ruten overhovedet svarer (ellers 503). Min. 16 tegn; generér med: openssl rand -base64 32
# Kald: curl -H "Authorization: Bearer $CRON_SECRET" "https://<host>/api/cron/frontpage-rank"   (valgfrit ?instans=<id>&ai=0)
# Railway: en Cron-service kalder ruten over det private netværk (se docs/ops/RAILWAY-SETUP.md). PÅKRÆVET i produktion.
CRON_SECRET=""
# Hvor længe en godkendt forside vises før den udløber og fallback (deterministisk score -> seneste nyt) overtager (timer, 1–168; default 24)
# FRONTPAGE_SNAPSHOT_TTL_HOURS="24"

# ── Produktions-seed (npm run seed:prod; idempotent) ───────────────────────
# Opretter de 6 byer, roller og ÉN administrator med en tilfældig engangsadgangskode (printes én gang).
# ADMIN_EMAIL=""
# ADMIN_NAME="Administrator"
# ADMIN_INSTANCE_DOMAIN="slagelselokalt.dk"

# ── Seed (kun dev/staging; seed afviser NODE_ENV=production) ───────────────
# Adgangskode til demo-brugerne (min. 12 tegn). Hvis tom, genereres en tilfældig og vises i terminalen.
# SEED_DEMO_PASSWORD=""

# ── Drift ──────────────────────────────────────────────────────────────────
# Rate limits og login-lockout er proces-lokale (lib/ratelimit). I produktion med flere instanser:
# tilslut en delt store (Redis/Upstash eller Postgres) via setRateLimitStore().
# Railway: REDIS_URL=${{Redis.REDIS_URL}}. Uden REDIS_URL advarer serveren ved start (proces-lokale grænser).
# REDIS_URL=""

# ── Uploads (lib/media-storage.ts) ─────────────────────────────────────────
# local  = public/uploads (dev; forsvinder ved redeploy). volume = persistent Railway Volume.
# Uden UPLOAD_STORAGE vælges volume automatisk hvis UPLOAD_DIR eller en Railway Volume (RAILWAY_VOLUME_MOUNT_PATH) findes.
# UPLOAD_STORAGE="volume"
# UPLOAD_DIR="/data/uploads"   (absolut sti på volumen)

# ── SEO pr. by (valgfri JSON, nøgle = domæne) ──────────────────────────────
# SEO_SITE_CONFIG='{"slagelselokalt.dk":{"sameAs":["https://www.facebook.com/…"]}}'


# ── Kant, bots og sikkerhedsheadere (docs/ops/EDGE-HARDENING.md) ───────────
# Klient-IP (lib/client-ip.ts): bag Cloudflare + Railway: TRUST_CLOUDFLARE=1 og TRUSTED_PROXY_HOPS=2; kun Railway: TRUSTED_PROXY_HOPS=1 (standard).
# TRUST_CLOUDFLARE=1 KRÆVER ORIGIN_SECRET (min. 24 tegn): i produktion er det en STARTFEJL at sætte det uden (ellers kan CF-Connecting-IP forfalskes og rate limit/lockout omgås).
# TRUST_CLOUDFLARE=""
# TRUSTED_PROXY_HOPS="1"
# Origin-lås: i produktion afvises alt uden header "x-origin-secret: <værdi>" (undtagen /api/health, /api/ready, /api/cron/*). Min. 24 tegn.
# ORIGIN_SECRET=""
# Tenant/vært (lib/trusted-host.ts): som standard bruges KUN Host. X-Forwarded-Host kan sættes af klienten og ignoreres, medmindre kanten
# garanterer at den overskrives/tilføjes til — sæt da TRUST_FORWARDED_HOST=1 (elementet TRUSTED_PROXY_HOPS pladser fra højre bruges).
# TRUST_FORWARDED_HOST=""
# Ejer-afhængige udsagn pr. by (lib/owner-config.ts): ansvarshavende redaktør, Pressenævnet, privatlivsside-felter. Tomme felter udelades.
# OWNER_CONFIG='{"*":{"pressenaevnetTilmeldt":false},"naestvedlokalt.dk":{"ansvarshavendeRedaktoer":"…","privatliv":{"dataansvarlig":"CVR … , adresse …","godkendt":false}}}'
# CSP: Report-Only i udvikling, håndhævet i produktion. CSP_REPORT_ONLY=1 tvinger Report-Only (anbefalet de første dage efter lancering).
# CSP_REPORT_ONLY=""
# CSP_IMG_HOSTS="cdn.example.dk"      # ekstra tilladte billedværter (kommasepareret)
# Cache af anonym HTML (s-maxage/stale-while-revalidate). Standard: til i produktion, fra i udvikling.
# CACHE_PUBLIC_HTML="1"  CACHE_HTML_S_MAXAGE="60"  CACHE_HTML_SWR="300"
# Cloudflare cache-purge ved publicering (valgfrit; no-op uden): token med rettigheden Zone > Cache Purge.
# CF_API_TOKEN=""  CF_ZONE_ID=""   # eller CF_ZONE_IDS='{"naestvedlokalt.dk":"<zone-id>"}' ved én zone pr. by
# Turnstile (valgfrit): site-nøglen er offentlig, hemmeligheden kun på serveren.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# Grænser: PAGE_RATE_LIMIT_PER_MIN="300" (pr. IP, proces-lokal), PUBLIC_BODY_MAX_BYTES="1048576", OG_CONCURRENCY="4",
# RATELIMIT_FAIL_CLOSED="1" (0 = login/indtag fejler ikke lukket når Redis er nede), SERVER_ACTIONS_BODY_LIMIT="12mb"

# ── Knowledge OS: redaktionel hukommelse ────────────────────────────────
# Default disabled. Mock bruger tydeligt markerede testdata, ingen netværkskald.
KNOWLEDGE_MODE="disabled"
# Kun isoleret legacy-sandbox; ingen multi-tenant produktionsmode endnu.
# KNOWLEDGE_MODE="legacy-sandbox"
# KNOWLEDGE_SANDBOX_CONFIRMED="true"
# KNOWLEDGE_CMS_INSTANCE_ID="<eksisterende CMS CUID>"
# KNOWLEDGE_TENANT_ID="<Knowledge OS tenant UUID>"
# KNOWLEDGE_INSTANCE_ID="<Knowledge OS instance UUID>"
# KNOWLEDGE_OS_URL="https://<isoleret-sandbox-origin>"
# KNOWLEDGE_OS_API_KEY=""  # server-only, aldrig NEXT_PUBLIC_
